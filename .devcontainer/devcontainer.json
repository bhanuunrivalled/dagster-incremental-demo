{
  "name": "Dagster incremental demo",
  "build": { "dockerfile": "Dockerfile" },
  "remoteUser": "vscode",
  "containerEnv": {
    "DAGSTER_HOME": "${containerWorkspaceFolder}/.local/dagster"
  },
  "postCreateCommand": "uv sync --frozen && uv run orders-demo init",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "Dagster lineage", "onAutoForward": "notify" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"],
      "settings": { "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python" }
    }
  }
}
